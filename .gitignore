# Local .terraform directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Crash log files
crash.log

# Exclude override files (but keep override.tf for sandbox testing)
# override.tf is used for HCP Terraform cloud backend configuration
# and should be tracked in git for team collaboration
override.tf.json
*_override.tf
*_override.tf.json

# Terraform variable files
*.tfvars
*.tfvars.json
!sandbox.auto.tfvars.example

# Terraform plan files
*.tfplan

# Sensitive files
.terraformrc
terraform.rc

# Sensitive files detected in current folder
**/.env
**/*.env
**/.env.*
.env
.env.local
.env.production
.env.development
.secret
secrets.yml
config.yaml
config.json
credentials.json

# exclude agent sandbox files backend and tfvars
sandbox.auto.tfvars
sandbox.backend.tf
